# clang-tidy configuration for Snowglobe.
# HeaderFilterRegex scopes diagnostics to our own headers so vcpkg/uWS headers
# are never analyzed (mirrors the build's "warnings in deps don't break us").
Checks: >
  -*,
  bugprone-*,
  concurrency-*,
  cppcoreguidelines-*,
  misc-*,
  modernize-*,
  performance-*,
  portability-*,
  readability-*,
  -modernize-use-trailing-return-type,
  -misc-include-cleaner,
  -readability-identifier-length,
  -readability-magic-numbers,
  -cppcoreguidelines-avoid-magic-numbers,
  -cppcoreguidelines-avoid-non-const-global-variables,
  -misc-non-private-member-variables-in-classes,
  -cppcoreguidelines-non-private-member-variables-in-classes
WarningsAsErrors: ''
HeaderFilterRegex: '.*/(src|tests|benchmarks)/.*'
FormatStyle: file
